      "source": [
        "\n",
        "# Program to demonstrate type casting\n",
        "\n",
        "a = 10        # integer\n",
        "b = 5.5       # float\n",
        "\n",
        "print(\"Original value of a:\", a, \"Type:\", type(a))\n",
        "print(\"Original value of b:\", b, \"Type:\", type(b))\n",
        "\n",
        "# Type casting\n",
        "a = float(a)\n",
        "b = int(b)\n",
        "\n",
        "print(\"After type casting a:\", a, \"Type:\", type(a))\n",
        "print(\"After type casting b:\", b, \"Type:\", type(b))"
      ],
